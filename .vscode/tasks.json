{
  "version": "2.0.0",
  "tasks": [
    {
      // Lance Claude Code dans un terminal dédié dès l'ouverture du dossier
      // (devcontainer). Si le CLI manque (ex. install réseau échouée au
      // post-create), il est (ré)installé puis exécuté. Repris de MyMathsBook.
      "label": "Claude Code",
      "type": "shell",
      "command": "export PATH=\"$HOME/.local/bin:$PATH\"; command -v claude >/dev/null 2>&1 || curl -fsSL https://claude.ai/install.sh | bash; exec claude",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "group": "claude"
      },
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
